# ==============================================================================
# CONFIGURAÇÕES DA IA LOCAL - MEETING AI SUMMARIZER (PT-BR)
# Copie este arquivo para '.env' caso queira sobrescrever os valores padrão.
# ==============================================================================

# 1. MODELO E SERVIÇO DO OLLAMA (LLM LOCAL)
OLLAMA_BASE_URL=http://ollama:11434

# Modelo padrão: Gemma 4 12B (Multimodal nativo, 128k contexto, excelente em PT-BR)
OLLAMA_MODEL=gemma4:12b

# Outros modelos compatíveis:
# - gemma2:27b    (Topo de linha Google 27B)
# - qwen2.5:14b   (Alta precisão em matriz de ações e JSON)
# - llama3.1:8b   (Equilibrado)
# - llama3.2:3b   (Leve)

# Tamanho máximo da janela de contexto para reuniões longas (ex: 16384, 32768)
OLLAMA_NUM_CTX=32768

# Piso de tokens para a resposta do LLM. O valor efetivo é calculado pelo pior caso do
# schema da ata (limites de itens/caracteres), então a resposta não é cortada e refeita.
OLLAMA_NUM_PREDICT=4096

# Reuniões que não cabem em OLLAMA_NUM_CTX são resumidas em blocos (map-reduce) deste tamanho
MINUTES_CHUNK_TOKENS=6000

# Confiança mínima para aplicar automaticamente um nome de locutor inferido pela IA (0 a 1)
SPEAKER_NAME_MIN_CONFIDENCE=0.75

# 2. MODELO DE TRANSCRIÇÃO (FASTER-WHISPER)
# Opções: tiny, base, small, medium, large-v3
WHISPER_MODEL_SIZE=medium

# Dispositivo: 'cpu' ou 'cuda' (para GPU NVIDIA)
WHISPER_DEVICE=cpu

# Tipo de computação: 'int8' para CPU, 'float16' para GPU CUDA
WHISPER_COMPUTE_TYPE=int8

# Idioma da reunião ('pt' para Português do Brasil)
DEFAULT_LANGUAGE=pt

# 3. SEPARAÇÃO DE PESSOAS (DIARIZAÇÃO 100% LOCAL & OFFLINE)
# auto = pyannote community-1 (se baixado) -> SpeechBrain -> motor acústico
DIARIZATION_ENGINE=auto

# Token do Hugging Face: usado SOMENTE pelo script de download (uma vez), nunca em processamento.
# docker compose run --rm -e HF_HUB_OFFLINE=0 app python -m backend.scripts.download_models --hf-token hf_xxx
HF_TOKEN=

# 1 = nenhum acesso à rede para modelos (padrão). Use 0 apenas durante o download.
HF_HUB_OFFLINE=1

# 4. LIMITES E EXECUÇÃO
MAX_FILE_SIZE_MB=500

# Quantos processamentos pesados podem rodar ao mesmo tempo (1 evita disputa de GPU/VRAM)
MAX_CONCURRENT_JOBS=1
