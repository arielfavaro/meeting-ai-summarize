# ==============================================================================
# CONFIGURAÇÕES DA IA LOCAL - MEETING AI SUMMARIZER (PT-BR)
# Copie este arquivo para '.env' caso queira sobrescrever os valores padrão.
# ==============================================================================

# 1. MODELO E SERVIÇO DO OLLAMA (LLM LOCAL)
# No compose padrão, aponte para 'http://ollama:11434'.
# Se quiser usar o Ollama já instalado no seu Windows/host, aponte para:
# OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_BASE_URL=http://ollama:11434

# Modelo padrão do Ollama para gerar a ata executiva.
# Exemplos recomendados para PT-BR:
# - llama3.2:3b   (Leve, veloz, excelente redação de atas)
# - qwen2.5:7b    (Altíssima qualidade de síntese e estrutura)
# - mistral:7b    (Muito bom para tópicos executivos)
OLLAMA_MODEL=llama3.2:3b

# 2. MODELO DE TRANSCRIÇÃO (FASTER-WHISPER)
# Opções: tiny, base, small, medium, large-v3
# 'small' é o mais recomendado em português (ótimo equilíbrio precisão/velocidade).
WHISPER_MODEL_SIZE=small

# Dispositivo: 'cpu' ou 'cuda' (para GPU NVIDIA)
WHISPER_DEVICE=cpu

# Tipo de computação: 'int8' para CPU, 'float16' para GPU CUDA
WHISPER_COMPUTE_TYPE=int8

# Idioma da reunião ('pt' para Português do Brasil)
DEFAULT_LANGUAGE=pt

# 3. SEPARAÇÃO DE PESSOAS (DIARIZAÇÃO DE LOCUTORES)
# Token gratuito do HuggingFace para usar o Pyannote oficial:
# Obtenha em: https://huggingface.co/settings/tokens
# E aceite os termos em: https://huggingface.co/pyannote/speaker-diarization-3.1
# NOTA: Se deixar em branco, o sistema utilizará o Diarizador Fallback nativo automaticamente.
HF_TOKEN=

# Habilitar Pyannote (se houver token)
ENABLE_PYANNOTE=true

# 4. LIMITES DE ARQUIVO
MAX_FILE_SIZE_MB=500
