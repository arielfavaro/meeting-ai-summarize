# ==============================================================================
# CONFIGURAÇÕES DA IA LOCAL - MEETING AI SUMMARIZER (PT-BR)
# Copie este arquivo para '.env' caso queira sobrescrever os valores padrão.
# ==============================================================================

# 0. GPU NVIDIA (recomendado se houver placa NVIDIA + NVIDIA Container Toolkit)
# Faz QUALQUER comando "docker compose" (up, run, restart, start.bat) incluir o override de GPU.
# Sem isso, um "docker compose run ..." (ex.: download de modelos) pode recriar o container do
# Ollama SEM GPU, e a ata passa a rodar na CPU (confira com: docker exec meeting-ai-ollama ollama ps).
# COMPOSE_PATH_SEPARATOR=;
# COMPOSE_FILE=docker-compose.yml;docker-compose.gpu.yml

# 1. MODELO E SERVIÇO DO OLLAMA (LLM LOCAL)
OLLAMA_BASE_URL=http://ollama:11434

# Modelo padrão: Gemma 4 12B (Multimodal nativo, 128k contexto, excelente em PT-BR)
OLLAMA_MODEL=gemma4:12b

# Outros modelos compatíveis:
# - gemma2:27b    (Topo de linha Google 27B)
# - qwen2.5:14b   (Alta precisão em matriz de ações e JSON)
# - llama3.1:8b   (Equilibrado)
# - llama3.2:3b   (Leve)

# Teto da janela de contexto (a janela real é planejada por reunião). Com flash attention e
# KV cache q8 no serviço ollama (padrão do docker-compose), 65536 cabe em 16 GB com o gemma4:12b.
OLLAMA_NUM_CTX=65536

# Penalidade de repetição já na 1ª tentativa da ata (0 desliga)
MINUTES_REPEAT_PENALTY=1.15

# LLM alternativo: llama-server (llama.cpp) para MoE grandes com experts na RAM.
# Suba com: docker compose -f docker-compose.yml -f docker-compose.gpu.yml --profile llamacpp up -d
# LLM_PROVIDER=llamacpp
# LLAMACPP_MODEL_FILE=Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf   (arquivo em data/llamacpp)
# LLAMACPP_N_CPU_MOE=24      (camadas de experts na CPU; ajuste para o llama-server usar ~10 GB de VRAM)
# LLAMACPP_CTX=65536

# Piso de tokens para a resposta do LLM. O valor efetivo é calculado pelo pior caso do
# schema da ata (limites de itens/caracteres), então a resposta não é cortada e refeita.
OLLAMA_NUM_PREDICT=4096

# Reuniões que não cabem em OLLAMA_NUM_CTX são resumidas em blocos (map-reduce) deste tamanho
MINUTES_CHUNK_TOKENS=6000

# Confiança mínima para aplicar automaticamente um nome de locutor inferido pela IA (0 a 1)
SPEAKER_NAME_MIN_CONFIDENCE=0.75

# 2. MODELO DE TRANSCRIÇÃO (FASTER-WHISPER)
# Opções: tiny, base, small, medium, large-v3
WHISPER_MODEL_SIZE=medium

# Dispositivo: 'cpu' ou 'cuda' (para GPU NVIDIA)
WHISPER_DEVICE=cpu

# Tipo de computação: 'int8' para CPU, 'float16' para GPU CUDA
WHISPER_COMPUTE_TYPE=int8

# Idioma da reunião ('pt' para Português do Brasil)
DEFAULT_LANGUAGE=pt

# Fuso horário dos logs, da data da ata e dos prazos relativos
APP_TIMEZONE=America/Sao_Paulo

# Multi-faixa (OBS): faixa dominada por uma voz vira 1 locutor (0 desativa) e eco entre faixas é removido
MULTITRACK_DOMINANT_SHARE=0.8
MULTITRACK_DEDUPE_ECHO=true

# 3. SEPARAÇÃO DE PESSOAS (DIARIZAÇÃO 100% LOCAL & OFFLINE)
# auto = pyannote community-1 (se baixado) -> SpeechBrain -> motor acústico
DIARIZATION_ENGINE=auto

# Token do Hugging Face: usado SOMENTE pelo script de download (uma vez), nunca em processamento.
# docker compose run --rm -e HF_HUB_OFFLINE=0 app python -m backend.scripts.download_models --hf-token hf_xxx
HF_TOKEN=

# 1 = nenhum acesso à rede para modelos (padrão). Use 0 apenas durante o download.
HF_HUB_OFFLINE=1

# Alinhamento forçado das palavras (wav2vec2 PT). "whisper" = usa os tempos do próprio Whisper
ALIGNMENT_ENGINE=wav2vec2

# Assinaturas de voz (SpeechBrain ECAPA local): funde locutores duplicados e reconhece pessoas já nomeadas
VOICE_FEATURES_ENABLED=true
VOICE_MERGE_THRESHOLD=0.70
VOICE_CROSS_TRACK_THRESHOLD=0.60
VOICE_LIBRARY_ENABLED=true
VOICE_MATCH_THRESHOLD=0.65
VOICE_MATCH_MARGIN=0.08

# 4. LIMITES E EXECUÇÃO
# Tamanho máximo do upload em MB (0 = sem limite)
MAX_FILE_SIZE_MB=0

# Quantos processamentos pesados podem rodar ao mesmo tempo (1 evita disputa de GPU/VRAM)
MAX_CONCURRENT_JOBS=1
